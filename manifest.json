{
  "manifest_version": 3,
  "name": "FrontierWatch",
  "version": "1.2.0",
  "description": "On-device detector for frontier-model activity: lab origin, unknown/unreleased builds, chat-template lineage, C2PA image credentials, and hidden Unicode.",
  "permissions": ["storage", "tabs", "webRequest", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["models.js", "lineage.js", "unicode.js", "provenance.js", "signatures.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FrontierWatch"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
